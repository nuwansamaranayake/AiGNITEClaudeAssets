# video-config.yaml
# Generated by higgsfield-media. Consumed by remotion-video.
# Edit narration, captions, and music before invoking remotion-video.

project_slug: "{{PROJECT_SLUG}}"
title: "{{TITLE}}"
duration_seconds: {{DURATION_SECONDS}}
aspect_ratio: "{{ASPECT_RATIO}}"
fps: 30
output_path: "output/{{DATE}}/{{PROJECT_SLUG}}/final.mp4"

