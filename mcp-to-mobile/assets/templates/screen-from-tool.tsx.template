// Screen generated from MCP tool: {{TOOL_NAME}}
// Source: {{MCP_SERVER_URL}}
// Generated by AiGNITE mcp-to-mobile skill.

import { useState } from 'react';
import { View, Text, ScrollView, StyleSheet } from 'react-native';
import { theme } from '../../lib/theme';
import { callTool, extractText } from '../../services/mcp-client';
import { McpToolForm } from '../../components/McpToolForm';
import { SubscriptionGate } from '../../components/SubscriptionGate';
import { useQuota } from '../../hooks/useQuota';

const TOOL_NAME = '{{TOOL_NAME}}';
const TOOL_TITLE = '{{TOOL_TITLE}}';
const TOOL_DESCRIPTION = '{{TOOL_DESCRIPTION}}';
const INPUT_SCHEMA = {{INPUT_SCHEMA_JSON}};

export default function {{COMPONENT_NAME}}Screen() {
  const { remaining, isPaid } = useQuota();
  const [result, setResult] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [showGate, setShowGate] = useState(false);

  async function onSubmit(input: Record<string, unknown>) {
    if (!isPaid && remaining <= 0) {
      setShowGate(true);
      return;
    }
    setLoading(true);
    setError(null);
    setResult(null);
    try {
      const callResult = await callTool(TOOL_NAME, input);
      if (callResult.isError) throw new Error(extractText(callResult));
      setResult(extractText(callResult));
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Unknown error');
    } finally {
      setLoading(false);
    }
  }

  if (showGate) {
    return <SubscriptionGate onDismiss={() => setShowGate(false)} />;
  }

  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.content}>
      <Text style={styles.title}>{TOOL_TITLE}</Text>
      <Text style={styles.description}>{TOOL_DESCRIPTION}</Text>

      <McpToolForm schema={INPUT_SCHEMA} onSubmit={onSubmit} loading={loading} />

      {error && (
        <View style={styles.errorCard}>
          <Text style={styles.errorText}>{error}</Text>
        </View>
      )}

      {result && (
        <View style={styles.resultCard}>
          <Text style={styles.resultText}>{result}</Text>
        </View>
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: theme.colors.bg },
  content: { padding: theme.spacing.md, gap: theme.spacing.md },
  title: { ...theme.typography.h1, color: theme.colors.text },
  description: { ...theme.typography.body, color: theme.colors.textMuted },
  errorCard: {
    padding: theme.spacing.md,
    borderRadius: theme.radii.md,
    backgroundColor: theme.colors.danger,
  },
  errorText: { color: theme.colors.text, ...theme.typography.body },
  resultCard: {
    padding: theme.spacing.md,
    borderRadius: theme.radii.md,
    backgroundColor: theme.colors.surface,
    borderColor: theme.colors.border,
    borderWidth: 1,
  },
  resultText: { color: theme.colors.text, ...theme.typography.body },
});
