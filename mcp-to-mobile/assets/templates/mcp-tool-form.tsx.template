// Generic MCP tool form renderer. Renders a form from a JSON Schema.
// Generated by AiGNITE mcp-to-mobile skill.

import { useState } from 'react';
import { View, Text, TextInput, Switch, Pressable, StyleSheet } from 'react-native';
import { theme } from '../lib/theme';

type Schema = {
  type: string;
  properties?: Record<string, Schema>;
  required?: string[];
  enum?: string[];
  description?: string;
  title?: string;
};

type Props = {
  schema: Schema;
  onSubmit: (data: Record<string, unknown>) => void;
  loading?: boolean;
};

export function McpToolForm({ schema, onSubmit, loading }: Props) {
  const [values, setValues] = useState<Record<string, unknown>>({});

  function setField(key: string, value: unknown) {
    setValues((prev) => ({ ...prev, [key]: value }));
  }

  function renderField(key: string, fieldSchema: Schema) {
    const label = fieldSchema.title ?? key;
    const required = schema.required?.includes(key) ?? false;

    if (fieldSchema.enum) {
      return (
        <View key={key} style={styles.field}>
          <Text style={styles.label}>{label}{required ? ' *' : ''}</Text>
          <View style={styles.enumRow}>
            {fieldSchema.enum.map((opt) => (
              <Pressable
                key={opt}
                style={[
                  styles.enumOption,
                  values[key] === opt && styles.enumOptionActive,
                ]}
                onPress={() => setField(key, opt)}
              >
                <Text style={[
                  styles.enumText,
                  values[key] === opt && styles.enumTextActive,
                ]}>{opt}</Text>
              </Pressable>
            ))}
          </View>
        </View>
      );
    }

    if (fieldSchema.type === 'boolean') {
      return (
        <View key={key} style={[styles.field, styles.booleanRow]}>
          <Text style={styles.label}>{label}</Text>
          <Switch
            value={Boolean(values[key])}
            onValueChange={(v) => setField(key, v)}
          />
        </View>
      );
    }

    return (
      <View key={key} style={styles.field}>
        <Text style={styles.label}>{label}{required ? ' *' : ''}</Text>
        <TextInput
          style={styles.input}
          value={values[key] != null ? String(values[key]) : ''}
          onChangeText={(t) => setField(key, fieldSchema.type === 'number' ? Number(t) : t)}
          keyboardType={fieldSchema.type === 'number' ? 'numeric' : 'default'}
          placeholder={fieldSchema.description ?? ''}
          placeholderTextColor={theme.colors.textMuted}
        />
      </View>
    );
  }

  const fields = schema.properties ?? {};

  return (
    <View style={styles.form}>
      {Object.entries(fields).map(([key, field]) => renderField(key, field))}
      <Pressable
        style={[styles.submit, loading && styles.submitDisabled]}
        onPress={() => onSubmit(values)}
        disabled={loading}
      >
        <Text style={styles.submitText}>{loading ? 'Working...' : 'Submit'}</Text>
      </Pressable>
    </View>
  );
}

const styles = StyleSheet.create({
  form: { gap: theme.spacing.md },
  field: { gap: theme.spacing.xs },
  label: { ...theme.typography.body, color: theme.colors.text, fontWeight: '600' },
  input: {
    borderWidth: 1,
    borderColor: theme.colors.border,
    borderRadius: theme.radii.md,
    padding: theme.spacing.sm,
    color: theme.colors.text,
    backgroundColor: theme.colors.surface,
  },
  enumRow: { flexDirection: 'row', flexWrap: 'wrap', gap: theme.spacing.xs },
  enumOption: {
    paddingHorizontal: theme.spacing.md,
    paddingVertical: theme.spacing.xs,
    borderRadius: theme.radii.pill,
    backgroundColor: theme.colors.surface,
    borderWidth: 1,
    borderColor: theme.colors.border,
  },
  enumOptionActive: { backgroundColor: theme.colors.primary, borderColor: theme.colors.primary },
  enumText: { color: theme.colors.text },
  enumTextActive: { color: theme.colors.primaryFg, fontWeight: '600' },
  booleanRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' },
  submit: {
    backgroundColor: theme.colors.primary,
    paddingVertical: theme.spacing.md,
    borderRadius: theme.radii.pill,
    alignItems: 'center',
  },
  submitDisabled: { opacity: 0.6 },
  submitText: { color: theme.colors.primaryFg, ...theme.typography.body, fontWeight: '700' },
});
