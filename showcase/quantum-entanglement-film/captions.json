[
 {
  "start": 2.28,
  "end": 5.558,
  "text": "Everything around you is made of tiny particles."
 },
 {
  "start": 5.697,
  "end": 8.231,
  "text": "Sometimes, two of them are born together,"
 },
 {
  "start": 8.37,
  "end": 10.399,
  "text": "in a single flash of light."
 },
 {
  "start": 11.673,
  "end": 13.343,
  "text": "These two are now entangled."
 },
 {
  "start": 13.482,
  "end": 15.437000000000001,
  "text": "Think of each one as having a color,"
 },
 {
  "start": 15.477,
  "end": 16.8,
  "text": "blue or gold."
 },
 {
  "start": 16.926,
  "end": 18.149,
  "text": "In real labs,"
 },
 {
  "start": 18.189,
  "end": 19.925,
  "text": "this is a property like spin."
 },
 {
  "start": 20.064,
  "end": 21.122,
  "text": "But right now,"
 },
 {
  "start": 21.368,
  "end": 23.369,
  "text": "neither particle has a color yet."
 },
 {
  "start": 23.482,
  "end": 26.295,
  "text": "Each one is an undecided mix of both."
 },
 {
  "start": 27.364,
  "end": 28.902,
  "text": "Now we send them far apart."
 },
 {
  "start": 29.053,
  "end": 29.992,
  "text": "One meter."
 },
 {
  "start": 30.13,
  "end": 31.414,
  "text": "Across the Earth."
 },
 {
  "start": 31.553,
  "end": 33.091,
  "text": "Across the galaxy."
 },
 {
  "start": 33.215,
  "end": 35.524,
  "text": "The link between them does not fade."
 },
 {
  "start": 37.01,
  "end": 40.142,
  "text": "Now someone measures the first particle."
 },
 {
  "start": 40.255,
  "end": 42.868,
  "text": "It turns blue, purely by chance."
 },
 {
  "start": 42.994,
  "end": 45.095,
  "text": "And at that very same instant,"
 },
 {
  "start": 45.135,
  "end": 48.746,
  "text": "its partner, far across space, turns gold."
 },
 {
  "start": 48.858,
  "end": 50.527,
  "text": "Always the opposite color."
 },
 {
  "start": 52.131,
  "end": 55.543,
  "text": "Repeat this with new pairs, again and again."
 },
 {
  "start": 55.669,
  "end": 57.006,
  "text": "On each side alone,"
 },
 {
  "start": 57.091,
  "end": 60.171,
  "text": "the colors look as random as coin flips."
 },
 {
  "start": 60.31,
  "end": 62.105000000000004,
  "text": "But compare the two lists,"
 },
 {
  "start": 62.145,
  "end": 64.174,
  "text": "and every pair is opposite."
 },
 {
  "start": 64.299,
  "end": 65.503,
  "text": "Every single time."
 },
 {
  "start": 67.106,
  "end": 68.768,
  "text": "Is this like hiding a blue ball"
 },
 {
  "start": 68.808,
  "end": 71.011,
  "text": "and a gold ball in two boxes?"
 },
 {
  "start": 71.136,
  "end": 71.755,
  "text": "No."
 },
 {
  "start": 71.88,
  "end": 73.59599999999999,
  "text": "In boxes, the colors are"
 },
 {
  "start": 73.636,
  "end": 74.999,
  "text": "set from the start."
 },
 {
  "start": 75.138,
  "end": 77.957,
  "text": "Careful experiments showed that entangled"
 },
 {
  "start": 77.997,
  "end": 80.518,
  "text": "particles carry no hidden answer."
 },
 {
  "start": 80.644,
  "end": 82.57199999999999,
  "text": "That work won the 2022"
 },
 {
  "start": 82.612,
  "end": 84.641,
  "text": "Nobel Prize in Physics."
 },
 {
  "start": 86.131,
  "end": 87.69999999999999,
  "text": "So, can we use this to"
 },
 {
  "start": 87.74,
  "end": 89.716,
  "text": "send messages faster than light?"
 },
 {
  "start": 89.828,
  "end": 90.447,
  "text": "No."
 },
 {
  "start": 90.573,
  "end": 93.466,
  "text": "Each person only sees random colors."
 },
 {
  "start": 93.605,
  "end": 96.871,
  "text": "The pattern appears only when they compare notes,"
 },
 {
  "start": 96.969,
  "end": 100.408,
  "text": "and those notes travel no faster than light."
 },
 {
  "start": 101.981,
  "end": 103.146,
  "text": "And this is real."
 },
 {
  "start": 103.245,
  "end": 107.606,
  "text": "In 2017, a satellite sent entangled particles"
 },
 {
  "start": 107.646,
  "end": 110.199,
  "text": "of light to two ground stations,"
 },
 {
  "start": 110.239,
  "end": 112.241,
  "text": "twelve hundred kilometers apart."
 },
 {
  "start": 112.354,
  "end": 115.851,
  "text": "Today, entanglement drives research in quantum"
 },
 {
  "start": 115.891,
  "end": 119.024,
  "text": "computers and ultra secure communication."
 },
 {
  "start": 120.506,
  "end": 121.711,
  "text": "Two particles."
 },
 {
  "start": 121.903,
  "end": 122.788,
  "text": "Far apart."
 },
 {
  "start": 122.887,
  "end": 124.331,
  "text": "Still acting as one."
 },
 {
  "start": 124.469,
  "end": 126.166,
  "text": "That is quantum entanglement."
 }
]