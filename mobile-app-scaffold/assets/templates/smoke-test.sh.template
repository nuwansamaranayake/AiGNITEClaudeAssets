#!/usr/bin/env bash
# Smoke test for {{APP_NAME}}
# Curl real business endpoints with a real token. Verify non-empty responses. Count DB tables.
# Generated by AiGNITE mobile-app-scaffold. Add a probe here every time you add an endpoint.

set -euo pipefail

if [ -f .env.local ]; then
  set -a
  # shellcheck disable=SC1091
  . .env.local
  set +a
fi

: "${EXPO_PUBLIC_SUPABASE_URL:?EXPO_PUBLIC_SUPABASE_URL missing}"
: "${EXPO_PUBLIC_SUPABASE_ANON_KEY:?EXPO_PUBLIC_SUPABASE_ANON_KEY missing}"
: "${SMOKE_TEST_TOKEN:?SMOKE_TEST_TOKEN missing. Create a test user and put their JWT here.}"

SUPABASE_URL="$EXPO_PUBLIC_SUPABASE_URL"
ANON="$EXPO_PUBLIC_SUPABASE_ANON_KEY"
TOKEN="$SMOKE_TEST_TOKEN"

# Expected table count. Update this when you add or remove tables.
EXPECTED_TABLES={{EXPECTED_TABLE_COUNT}}

fail() {
  echo "SMOKE FAIL: $1" >&2
  exit 1
}

probe() {
  local label="$1"
  local url="$2"
  local response
  response=$(curl -sS -w "\n%{http_code}" \
    -H "apikey: $ANON" \
    -H "Authorization: Bearer $TOKEN" \
    "$url")
  local body http_code
  body=$(echo "$response" | sed '$d')
  http_code=$(echo "$response" | tail -n1)
  if [ "$http_code" != "200" ]; then
    fail "$label returned $http_code"
  fi
  if [ -z "$body" ] || [ "$body" = "[]" ] || [ "$body" = "{}" ]; then
    fail "$label returned empty body"
  fi
  echo "OK   $label"
}

count_tables() {
  local response
  response=$(curl -sS \
    -H "apikey: $ANON" \
    -H "Authorization: Bearer $TOKEN" \
    "$SUPABASE_URL/rest/v1/rpc/count_public_tables")
  echo "$response"
}

echo "--- Smoke test: {{APP_NAME}} ---"

# Add a probe line per business endpoint below.
# probe "alerts list"        "$SUPABASE_URL/rest/v1/alerts?limit=1"
# probe "user profile"       "$SUPABASE_URL/rest/v1/profiles?limit=1"
# probe "mcp tool discovery" "{{MCP_SERVER_URL}}/tools"

# Table count check
actual=$(count_tables)
if [ "$actual" != "$EXPECTED_TABLES" ]; then
  fail "table count mismatch. expected=$EXPECTED_TABLES actual=$actual"
fi
echo "OK   table count: $actual"

echo "--- All smoke probes passed ---"
