// MCP client for {{APP_NAME}}
// Talks to an AiGNITE MCP server over Streamable HTTP.
// Generated by mobile-app-scaffold. The mcp-to-mobile skill extends this for tool-driven UIs.

const MCP_BASE_URL = process.env.EXPO_PUBLIC_MCP_SERVER_URL ?? '{{MCP_SERVER_URL}}';

export type McpToolDefinition = {
  name: string;
  description: string;
  inputSchema: Record<string, unknown>;
};

export type McpCallResult<T = unknown> = {
  content: Array<{ type: string; text?: string }>;
  isError?: boolean;
  structuredContent?: T;
};

async function rpc<T>(method: string, params?: Record<string, unknown>): Promise<T> {
  const response = await fetch(`${MCP_BASE_URL}/mcp`, {
    method: 'POST',
    headers: {
      'content-type': 'application/json',
      accept: 'application/json, text/event-stream',
    },
    body: JSON.stringify({
      jsonrpc: '2.0',
      id: Date.now(),
      method,
      params: params ?? {},
    }),
  });
  if (!response.ok) {
    throw new Error(`MCP RPC failed: ${response.status} ${response.statusText}`);
  }
  const payload = await response.json();
  if (payload.error) {
    throw new Error(`MCP error: ${payload.error.message}`);
  }
  return payload.result as T;
}

export async function listTools(): Promise<McpToolDefinition[]> {
  const result = await rpc<{ tools: McpToolDefinition[] }>('tools/list');
  return result.tools;
}

export async function callTool<T = unknown>(
  name: string,
  args: Record<string, unknown>
): Promise<McpCallResult<T>> {
  return rpc<McpCallResult<T>>('tools/call', { name, arguments: args });
}

export function extractText(result: McpCallResult): string {
  return result.content
    .filter((c) => c.type === 'text' && c.text)
    .map((c) => c.text)
    .join('\n');
}
